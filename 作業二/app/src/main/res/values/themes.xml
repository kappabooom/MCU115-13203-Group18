<resources>
    <style name="Theme.MyCalculator" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/calc_equals</item>
        <item name="colorPrimaryDark">@color/calc_status_bar</item>
        <item name="colorAccent">@color/calc_operator</item>
        <item name="android:statusBarColor">@color/calc_status_bar</item>
        <item name="android:windowBackground">@color/calc_background</item>
    </style>

    <!-- 共用按鈕樣式 -->
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/calc_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:textColor">@color/calc_operator</item>
        <item name="android:textSize">26sp</item>
    </style>
</resources>
