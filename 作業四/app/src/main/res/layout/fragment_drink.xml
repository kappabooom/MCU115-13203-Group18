<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_drink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgDrink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbCola"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drink_cola" />

        <RadioButton
            android:id="@+id/rbIcedTea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drink_iced_tea" />

        <RadioButton
            android:id="@+id/rbWater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drink_water" />
    </RadioGroup>

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_done" />
</LinearLayout>
